# ==============================================================================
# AI Email Agent Configuration
# ==============================================================================

# LLM Provider Configuration
# Choose: "gemini", "openai", or "auto" (falls back to built-in rule planner if no keys)
LLM_PROVIDER=auto

# Google Gemini API Key (Optional - get from https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Optional - get from https://platform.openai.com/)
OPENAI_API_KEY=

# Model Name (e.g. gemini-1.5-flash, gemini-2.0-flash, gpt-4o-mini)
LLM_MODEL=gemini-1.5-flash

# ==============================================================================
# SMTP / Gmail Configuration
# ==============================================================================
# To use Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate a 16-character App Password under Security > App passwords:
#    https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and the 16-character password below (without spaces):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_username@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_USE_TLS=true

# Sender Name displayed in email From header
SENDER_NAME=AI Email Agent
SENDER_EMAIL=your_gmail_username@gmail.com

# ==============================================================================
# Agent Safety & Behavioral Configuration
# ==============================================================================
# DRY_RUN: When set to true, the agent simulates email sending without touching real SMTP.
# Set to false to send real emails to recipients!
DRY_RUN=false

# REQUIRE_CONFIRMATION: Safety guardrail. Must be true for human-in-the-loop verification.
REQUIRE_CONFIRMATION=true
